# ==============================================================================
# CẤU HÌNH TÀI KHOẢN WIPTER (DÙNG DẤU NHÁY ĐÔI AN TOÀN)
# ==============================================================================
WIPTER_EMAIL=""
WIPTER_PASSWORD=""

# Runtime hardening / IP-Auth tuning
# Không gọi dịch vụ ngoài để check public IP; Docker bridge vẫn SNAT outbound qua IPv4 public của VPS.
WIPTER_DIAGNOSTIC_HOST_PORT="28999"
WIPTER_MAX_CONN_GLOBAL="2000"
WIPTER_MAX_CONN_PER_NODE="32"
WIPTER_IDLE_TIMEOUT_SEC="120"
# Chặn kết nối tới localhost/RFC1918/link-local/metadata để tránh bị dùng làm đường vào mạng nội bộ.
WIPTER_BLOCK_PRIVATE_TARGETS="true"

# Tùy chọn: giới hạn RAM container, ví dụ "256m" hoặc "512m". Để trống nếu không muốn giới hạn cứng.
WIPTER_MEMORY_LIMIT=""
