# WipterSlim: chạy Wipter image gốc qua proxy tunnel, giảm GUI/phụ trợ tối đa có thể.
WIPTER_EMAIL=""
WIPTER_PASSWORD=""
DEVICE_NAME="wipter"

# Resource per Wipter container
WIPTER_MEMORY="160m"
WIPTER_CPUS="0.25"
WIPTER_PIDS_LIMIT="256"

# Resource per tun2proxy sidecar
TUN_MEMORY="64m"
TUN_CPUS="0.10"

# Tối ưu nhẹ
KILL_GUI_HELPERS="true"
DISABLE_LOGS="true"
START_DELAY_SEC="2"

# Image versions
WIPTER_IMAGE="ghcr.io/techroy23/docker-wipter:latest"
TUN_IMAGE="ghcr.io/tun2proxy/tun2proxy:v0.8.3"
