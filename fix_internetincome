######################### InternetIncome TEST — KHỚP 4 SETUP HOST #########################
# Giữ nguyên token/email của bạn. Toàn bộ thông số Mạng/DNS/Hiệu năng đã được chuẩn hóa.
# Host (setup_vps / setup_vm / setup_oracle_cloud / setup_oracle_ARM64) quản lý:
#   ZRAM ZSTD, sysctl BBR, resolv.conf DIRECT, FlapGuard, Autosync Memory, Cron bảo trì.
# File này KHÔNG ĐƯỢC: Bật SOCKS5 DNS, Docker Embedded DNS, giới hạn cứng CPU/RAM, Watchtower.
# DNS App = DoH + DNS Cache TRONG TUN. DNS Host = 1.1.1.1 (Direct Upstream).
###########################################################################################

DEVICE_NAME='ubuntu'

REPOCKET_EMAIL=
REPOCKET_API=

TRAFFMONETIZER_TOKEN=

EARN_FM_API=
USE_EARN_FM_FLEETSHARE=false

PROXYRACK_API=
PROXYBASE_ACCOUNT_ID=

IPROYALS_EMAIL=
IPROYALS_PASSWORD=

HONEYGAIN_EMAIL=
HONEYGAIN_PASSWORD=
HONEYGAIN_POT=false

PEER2PROFIT_EMAIL=
ANTGAIN_API_KEY=
WIZARD_GAIN_EMAIL=

PACKETSTREAM_CID=
PROXYLITE_USER_ID=

EARNAPP=false
USE_EARNAPP_PRIVILEGED=false

BITPING_EMAIL=
BITPING_PASSWORD=

PACKETSHARE_EMAIL=
PACKETSHARE_PASSWORD=

WIPTER_EMAIL=
WIPTER_PASSWORD=

UR_AUTH_TOKEN=
UR_NETWORK_PROXY_MODE=false

TITAN_HASH=

MYSTERIUM=false
UPROCK=false

GRASS_EMAIL=
GRASS_PASSWORD=
GRADIENT_EMAIL=
GRADIENT_PASSWORD=

EBESUCHER_USERNAME=
EBESUCHER_USE_RANDOM_DISPLAY=false
ADNADE_USERNAME=
ADNADE_USE_CHROME=false
CUSTOM_FIREFOX=false
CUSTOM_FIREFOX_USE_RANDOM_DISPLAY=false
CUSTOM_CHROME=false

######################### Auto Update (Host tự quản lý) #########################
# Script setup Host đã tự gỡ Watchtower & có Cron prune image định kỳ.
AUTO_UPDATE_CONTAINERS=false

######################### Network — DUY NHẤT 1 CHẾ ĐỘ: PROXY #########################
# Tuyệt đối không bật cùng lúc direct / vpn / multi-ip.
USE_DIRECT_CONNECTION=false
USE_PROXIES=true
USE_VPNS=false
USE_MULTI_IP=false

# Proxy UDP/DNS không ổn định -> TẮT. Phân giải an toàn trong TUN, không nhờ SOCKS5.
USE_SOCKS5_DNS=false

# Nhánh Test + Proxy: Sử dụng DoH (DNS-over-HTTPS qua TCP) + Cache nội bộ trong TUN.
USE_DNS_OVER_HTTPS=true
USE_DNSCRYPT=false
USE_DNS_CACHE=true

# Không dùng Docker Embedded DNS (127.0.0.11) để tránh lệch GeoIP & đè DNS Direct.
USE_DOCKER_EMBEDDED_DNS=false

# Sử dụng mặc định hev-socks5-tunnel nhẹ & ổn định nhất cho High-Density Proxies.
USE_TUN2PROXY=false

# Không bật Custom Network (Chỉ dùng khi >1000 proxy và tự tune kernel riêng).
USE_CUSTOM_NETWORK=false

######################### Performance & IP-Auth Hardening #########################
ENABLE_LOGS=false
USE_DOCKER_INIT=false

# Độ trễ khởi tạo container lúc chạy lần đầu (Lúc reboot đã có ii-staggered-start lo).
DELAY_BETWEEN_CONTAINER=1

# TẮT kiểm tra probe qua Proxy để bảo vệ tuyệt đối cho Proxy dạng IP-Authentication.
VALIDATE_PROXIES=false

# GIỮ NGUYÊN COMMENT: Tuyệt đối không đặt giới hạn cứng để ii-autosync tự điều phối RAM.
#MAX_MEMORY=1024m
#MEMORY_RESERVATION=
#MEMORY_SWAP=
#CPU=1

