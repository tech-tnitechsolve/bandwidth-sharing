######################### Auto Update #########################
# setup cua ban xoa watchtower + tu prune image nhe. De II tu pull latest = danh nhau.
AUTO_UPDATE_CONTAINERS=false

######################### Network — 1 che do: PROXY #########################
# Khong bat 2 che do cung luc (direct+proxies / vpn / multi-ip).
USE_DIRECT_CONNECTION=false
USE_PROXIES=true
USE_VPNS=false
USE_MULTI_IP=false

# Proxy UDP/DNS khong on dinh → TAT. Resolve trong TUN, khong nho SOCKS5.
USE_SOCKS5_DNS=false

# Test + proxy: DoH/TCP + dnscrypt + cache. Khong dung stub host 127.0.0.53.
USE_DNS_OVER_HTTPS=true
USE_DNSCRYPT=false
USE_DNS_CACHE=true

# Khong de Docker Embedded DNS (127.0.0.11) — lech geo + danh host direct-DNS.
USE_DOCKER_EMBEDDED_DNS=false

# Khong ep tun2proxy: test + socks5 + DoH → hev-socks5-tunnel + dnscrypt (wiki).
USE_TUN2PROXY=false

# Chi khi >1000 proxy + da tune kernel (wiki). 4 setup host khong lam viec nay.
USE_CUSTOM_NETWORK=false

######################### Performance — de host lo RAM #########################
ENABLE_LOGS=false
USE_DOCKER_INIT=false

# Stagger: setup da co ii-staggered-start luc reboot. Day la delay KHI II spawn lan dau.
DELAY_BETWEEN_CONTAINER=1

VALIDATE_PROXIES=true

